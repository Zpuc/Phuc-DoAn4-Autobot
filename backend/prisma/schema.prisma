datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPING
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum CouponType {
  PERCENT
  FIXED_AMOUNT
}

enum InventoryChangeReason {
  IMPORT
  SALE
  RETURN
  ADJUST
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addresses    Address[]
  orders       Order[]
  statusLogs   OrderStatusHistory[]
  reviews      Review[]

  @@map("users")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  slug      String     @unique
  parentId  String?    @map("parent_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  logoUrl   String?   @map("logo_url")
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("brands")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  sku         String        @unique
  categoryId  String        @map("category_id") @db.Uuid
  brandId     String        @map("brand_id") @db.Uuid
  grade       String?       // HG, RG, MG, PG, SD, MEGA_SIZE...
  scale       String?       // 1/144, 1/100, 1/60...
  series      String?       // UC, SEED, 00, WFM...
  condition   String?       @default("NEW_SEAL") // NEW_SEAL, DENTED_BOX, ASSEMBLED
  description String?       @db.Text
  status      ProductStatus @default(ACTIVE)
  isPreorder  Boolean       @default(false) @map("is_preorder")
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category        Category             @relation(fields: [categoryId], references: [id])
  brand           Brand                @relation(fields: [brandId], references: [id])
  images          ProductImage[]
  prices          ProductPrice[]
  inventory       Inventory?
  inventoryLogs   InventoryLog[]
  orderItems      OrderItem[]
  quotationItems  QuotationItem[]
  purchaseItems   PurchaseOrderItem[]
  reviews         Review[]

  @@index([slug])
  @@index([categoryId, status])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  url         String
  sortOrder   Int      @default(0) @map("sort_order")
  isThumbnail Boolean  @default(false) @map("is_thumbnail")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductPrice {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  price         Decimal   @db.Decimal(12, 0)
  costPrice     Decimal   @default(0) @map("cost_price") @db.Decimal(12, 0)
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  note          String?

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveFrom(sort: Desc)])
  @@map("product_prices")
}

model Inventory {
  productId String   @id @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  minStock  Int      @default(2) @map("min_stock")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model InventoryLog {
  id        String                @id @default(uuid()) @db.Uuid
  productId String                @map("product_id") @db.Uuid
  change    Int
  reason    InventoryChangeReason
  refId     String?               @map("ref_id")
  createdAt DateTime              @default(now()) @map("created_at")

  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_logs")
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  contactPerson  String?         @map("contact_person")
  phone          String?
  email          String?
  address        String?

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique
  supplierId  String              @map("supplier_id") @db.Uuid
  status      String              @default("PENDING")
  totalAmount Decimal             @default(0) @map("total_amount") @db.Decimal(12, 0)
  createdAt   DateTime            @default(now()) @map("created_at")

  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  quantity        Int
  unitCost        Decimal       @map("unit_cost") @db.Decimal(12, 0)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model Address {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String? @map("user_id") @db.Uuid
  receiverName  String  @map("receiver_name")
  phone         String
  province      String
  district      String
  ward          String
  detailAddress String  @map("detail_address")
  isDefault     Boolean @default(false) @map("is_default")

  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("addresses")
}

model ShippingZone {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  districts String   @db.Text // Danh sách quận/huyện
  fee       Decimal  @db.Decimal(12, 0)
  isLocal   Boolean  @default(true) @map("is_local")

  @@map("shipping_zones")
}

model Order {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique
  userId          String?        @map("user_id") @db.Uuid
  customerName    String         @map("customer_name")
  customerPhone   String         @map("customer_phone")
  customerEmail   String?        @map("customer_email")
  shippingAddress String         @map("shipping_address") @db.Text
  shippingFee     Decimal        @default(0) @map("shipping_fee") @db.Decimal(12, 0)
  subtotal        Decimal        @db.Decimal(12, 0)
  couponCode      String?        @map("coupon_code")
  discountAmount  Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 0)
  total           Decimal        @db.Decimal(12, 0)
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod  @default(COD) @map("payment_method")
  trackingCode    String?        @map("tracking_code")
  note            String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]

  @@index([code])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 0)
  unitCost    Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 0)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  changedBy String?     @map("changed_by") @db.Uuid
  note      String?
  changedAt DateTime    @default(now()) @map("changed_at")

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@map("order_status_history")
}

model Quotation {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique
  customerName  String          @map("customer_name")
  customerPhone String          @map("customer_phone")
  validUntil    DateTime?       @map("valid_until")
  totalAmount   Decimal         @default(0) @map("total_amount") @db.Decimal(12, 0)
  status        String          @default("SENT") // DRAFT, SENT, ACCEPTED, EXPIRED
  note          String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")

  items         QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @map("quotation_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  quantity    Int
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 0)

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

model Coupon {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique
  description String?
  type        CouponType  @default(FIXED_AMOUNT)
  value       Decimal     @db.Decimal(12, 0)
  minOrder    Decimal     @default(0) @map("min_order") @db.Decimal(12, 0)
  maxDiscount Decimal?    @map("max_discount") @db.Decimal(12, 0)
  usageLimit  Int         @default(100) @map("usage_limit")
  usedCount   Int         @default(0) @map("used_count")
  validUntil  DateTime?   @map("valid_until")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("coupons")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  userName  String   @map("user_name")
  userEmail String?  @map("user_email")
  rating    Int      @default(5)
  title     String?
  comment   String   @db.Text
  gradeTag  String?  @map("grade_tag")
  likes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@map("reviews")
}

